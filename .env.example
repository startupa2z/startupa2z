# Local database and backend configuration
POSTGRES_PASSWORD=change_this_strong_password
JWT_SECRET=change_this_to_a_long_random_secret

# Optional frontend API origin. Leave blank when using the Vite or nginx proxy.
VITE_API_URL=

# Create the Startup A to Z WhatsApp Community, then paste its invite URL here.
# Expected format: https://chat.whatsapp.com/...
VITE_WHATSAPP_COMMUNITY_URL=
